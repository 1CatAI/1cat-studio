{
  "name": "onecat-studio-frontend",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build-onecat-preview.mjs && vite --config vite.onecat.config.ts",
    "build": "npm run build:onecat",
    "build:onecat": "node scripts/build-onecat-preview.mjs && tsc -p tsconfig.onecat.json && vite build --config vite.onecat.config.ts",
    "watch:onecat": "node scripts/build-onecat-preview.mjs && vite build --watch --config vite.onecat.config.ts",
    "typecheck:onecat": "tsc -p tsconfig.onecat.json --pretty false",
    "test": "node --experimental-strip-types --test tests/onecat-*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@tailwindcss/browser": "4.3.3",
    "@tanstack/react-router": "1.169.2",
    "katex": "^0.16.28",
    "lucide-react": "^1.7.0",
    "motion": "^12.34.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.7.0",
    "sonner": "^2.0.7",
    "streamdown": "2.5.0",
    "sucrase": "3.35.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "@radix-ui/react-popper": "1.3.7",
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/router-core": "1.169.2",
    "@tanstack/history": "1.161.6",
    "mermaid": "11.15.0",
    "hono": "4.12.25",
    "qs": "6.15.2",
    "ip-address": "10.1.1",
    "brace-expansion@^5": "5.0.8",
    "fast-uri@^3": "3.1.4",
    "remend": "1.3.1"
  }
